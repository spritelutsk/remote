<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CortenDeskRemote</AssemblyName>
    <RootNamespace>CortenDesk.Remote</RootNamespace>
    <ApplicationTitle>CortenDesk Remote</ApplicationTitle>
    <Version>1.0.0</Version>
    <!-- Собирать можно и на не-Windows (проверка компиляции). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- SelfContained/PublishSingleFile НЕ задаются здесь: они тянут за собой
         RuntimeIdentifier хоста и ломают сборку где угодно, кроме Windows.
         Передавайте их флагами publish, см. README. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Встроенный браузерный движок для веб-клиента CortenDesk. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- DPAPI: токен на диске шифруется ключом текущего пользователя Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
