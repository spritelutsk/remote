<Window x:Class="CortenDesk.Remote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="CortenDesk Remote"
        Height="640" Width="1100"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Шапка -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Устройства" Style="{StaticResource H1}" VerticalAlignment="Center"/>
          <TextBlock x:Name="ServerLabel" Style="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="14,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock x:Name="UserLabel" Style="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Выйти" Style="{StaticResource Secondary}" Click="OnLogoutClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Панель фильтров -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Bg}" Padding="16,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Поиск" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="SearchBox" Width="240" TextChanged="OnFilterChanged"/>

        <TextBlock Text="Папка" VerticalAlignment="Center" Margin="18,0,8,0"/>
        <ComboBox x:Name="GroupBox" Width="180" SelectionChanged="OnFilterChanged"/>

        <CheckBox x:Name="OnlineOnlyBox" Content="Только в сети" VerticalAlignment="Center"
                  Foreground="{StaticResource Fg}" Margin="18,0,0,0"
                  Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>

        <Button Content="Обновить" Style="{StaticResource Secondary}" Margin="18,0,0,0"
                Click="OnRefreshClick"/>
      </StackPanel>
    </Border>

    <!-- Статус-строка -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,7">
      <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"/>
    </Border>

    <!-- Таблица устройств -->
    <Border Margin="16,0,16,12" Background="{StaticResource Card}"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
      <DataGrid x:Name="DeviceGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{StaticResource Line}"
                Background="{StaticResource Card}"
                RowBackground="{StaticResource Card}"
                BorderThickness="0"
                SelectionMode="Single"
                CanUserSortColumns="True"
                MouseDoubleClick="OnRowDoubleClick">

        <DataGrid.Resources>
          <Style TargetType="{x:Type prim:DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource Soft}"/>
            <Setter Property="Foreground" Value="{StaticResource Mut}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
          </Style>

          <!-- Меню висит на строке, а не на сетке: тогда его DataContext -
               сама строка, и правый клик не зависит от выделения. -->
          <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Подключиться" Click="OnConnectClick"/>
            <MenuItem Header="Копировать ID" Click="OnCopyIdClick"/>
            <Separator/>
            <MenuItem Header="Открыть в браузере" Click="OnOpenInBrowserClick"/>
          </ContextMenu>
        </DataGrid.Resources>

        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
          </Style>
        </DataGrid.RowStyle>

        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="34" CanUserSort="True"
                                  SortMemberPath="IsOnline">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                         ToolTip="{Binding StatusText}">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource Off}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Ok}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*"/>
          <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" FontFamily="Consolas"/>
          <DataGridTextColumn Header="ОС" Binding="{Binding Os}" Width="Auto"/>
          <DataGridTextColumn Header="Пользователь" Binding="{Binding LocalUser}" Width="*"/>
          <DataGridTextColumn Header="Владелец" Binding="{Binding Owner}" Width="*"/>
          <DataGridTextColumn Header="Папка" Binding="{Binding Group}" Width="*"/>
          <DataGridTextColumn Header="Заметка" Binding="{Binding Note}" Width="2*"/>

          <DataGridTemplateColumn Header="" Width="140" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Подключиться" Style="{StaticResource Primary}"
                        Margin="6,4" Padding="10,4" Click="OnConnectClick"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

  </DockPanel>
</Window>
